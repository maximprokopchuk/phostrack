# OPENROUTER_API_KEY: Required for OpenRouter AI API calls (Llama 3.1 8B).
# Get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# VITE_OPENROUTER_API_KEY: Alternative env var name for Vite dev server (same key).
VITE_OPENROUTER_API_KEY="sk-or-v1-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
